{
  "name": "nutrinook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5187 --strictPort",
    "build": "tsc --noEmit && vite build --base ./",
    "build:portable": "tsc --noEmit && node scripts/build-portable.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-check.mjs",
    "test:portable": "node scripts/portable-check.mjs",
    "theme:template": "node scripts/build-theme-sheet.mjs",
    "test:themes": "node scripts/theme-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto-slab": "^5.2.0",
    "@fontsource/special-elite": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright-core": "^1.55.0",
    "prettier": "^3.6.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  }
}
